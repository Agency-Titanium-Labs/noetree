# Stripe secret key — SECRET, server-only. One value per environment.
# From Stripe Dashboard -> Developers -> API keys (test mode).
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe webhook signing secret — SECRET, server-only. DISTINCT value per environment.
# Local: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
# Staging/production: Stripe Dashboard -> Webhooks -> [endpoint] -> Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe CONNECT webhook signing secret — SECRET, server-only. DISTINCT value
# per environment, and DISTINCT from STRIPE_WEBHOOK_SECRET above — reusing the
# platform secret here breaks Connect event delivery entirely. Registered
# separately with connect: true (Dashboard: "Listen to events on Connected
# accounts").
# Local: `stripe listen --forward-to localhost:3000/api/webhooks/stripe --forward-connect-to localhost:3000/api/webhooks/stripe-connect`.
# Staging/production: Stripe Dashboard -> Webhooks -> [connect-scoped endpoint] -> Signing secret.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx

# Internal shared secret: Next.js webhook route -> Convex dispatcher action authentication.
# SECRET, server-only. Set identically in both environments:
#   Next.js:  add to .env.local / hosting provider env vars
#   Convex:   `npx convex env set INTERNAL_WEBHOOK_SECRET <value>`
# Generate with: openssl rand -hex 32
INTERNAL_WEBHOOK_SECRET=

# Stripe Price IDs — created once in test mode, can be shared across environments.
# STRIPE_PRO_PRICE_ID is LEGACY (v1.2 Premium repricing): retained ONLY so the
# one-time `npm run stripe:migrate-premium` / `npm run stripe:archive-old-price`
# scripts can enumerate and archive subscribers still on the old 9 EUR price.
# It is referenced by no runtime code path after phase 12.
STRIPE_PRO_PRICE_ID=price_xxx
# STRIPE_TOPUP_PRICE_ID is LEGACY (pre-Phase-16 top-up): only needed for in-flight
# top-up sessions during the legacy window; also set it in Convex env then.
STRIPE_TOPUP_PRICE_ID=price_xxx

# Stripe credit pack Price IDs — produced by `pnpm stripe:setup-packs`.
# Must ALSO be set in each Convex deployment (dev + prod):
#   npx convex env set STRIPE_PACK_BOOST_PRICE_ID <id>   (and the other two)
STRIPE_PACK_DECOUVERTE_PRICE_ID=price_xxx
STRIPE_PACK_BOOST_PRICE_ID=price_xxx
STRIPE_PACK_PRO_PRICE_ID=price_xxx

# Stripe Premium Price IDs — produced by `npm run stripe:setup-premium`
# (renames the Product to "Premium" and creates these two new recurring Prices).
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_xxx
STRIPE_PREMIUM_ANNUAL_PRICE_ID=price_xxx

# Stripe publishable key — PUBLIC, safe to expose in the client bundle.
# Must keep the NEXT_PUBLIC_ prefix (Next.js inlines this at build time).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# App's absolute origin — server-only, NOT public. One value per environment.
# Used to build Stripe success_url/cancel_url (Stripe requires fully-qualified URLs).
# Local: matches the `next dev --experimental-https` dev script.
# Staging/production: the deployed app's real origin.
APP_URL=https://localhost:3000
