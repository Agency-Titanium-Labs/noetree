    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/eslint-plugin-query": "^5.101.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cypress": "^1.1.6",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25",
