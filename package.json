{
  "name": "noetree",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev --experimental-https\" \"convex dev\"",
    "build": "next build",
    "start": "next start",
    "start:ci": "next start -p 3000",
    "lint": "eslint .",
    "convex": "npx convex dev",
    "stripe:setup-premium": "ts-node --project scripts/tsconfig.json scripts/setup-premium-prices.ts",
    "stripe:setup-packs": "ts-node --project scripts/tsconfig.json scripts/setup-credit-packs.ts",
    "stripe:migrate-premium": "ts-node --project scripts/tsconfig.json scripts/migrate-pro-to-premium.ts",
    "stripe:archive-old-price": "ts-node --project scripts/tsconfig.json scripts/archive-old-pro-price.ts",
    "test": "prettier --write . && eslint app/ --fix ",
    "test:unit": "vitest run",
    "prepare": "husky install",
    "cypress": "cypress open",
    "cy:run": "cypress run",
    "test-cypress": "start-server-and-test start http://localhost:3000 cy:run"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.3",
    "@dnd-kit/dom": "^0.4.0",
