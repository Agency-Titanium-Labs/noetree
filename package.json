    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-resizable-panels": "^4.11.2",
    "sonner": "2.0.8",
    "stripe": "22.3.0",
    "tailwind-merge": "^3.6.0",
