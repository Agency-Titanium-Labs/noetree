    "@types/testing-library__react": "^10.2.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "concurrently": "^10.0.3",
    "convex-test": "^0.0.54",
    "cypress": "^15.16.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.5.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
